# Environment Configuration Template for Expense Tracker
# Copy this file to .env and update with your actual values

# Application Environment
ENVIRONMENT=development  # development, staging, production

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=expense_tracker

# JWT Security Configuration  
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_KEY_ROTATION_DAYS=30
JWT_KEY_ID=default
JWT_PREVIOUS_KEYS=

# HTTPS and Security Configuration
HTTPS_ONLY=false  # Set to true in production
SECURE_COOKIES=false  # Set to true in production with HTTPS

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com  # Comma-separated production origins

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=5/minute
AUTH_BURST_LIMIT=20/hour
WRITE_RATE_LIMIT=100/minute
WRITE_BURST_LIMIT=1000/hour
API_RATE_LIMIT=1000/minute
API_BURST_LIMIT=10000/hour

# Security Headers (optional overrides)
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'

# Observability & Monitoring Configuration
LOG_LEVEL=INFO
JSON_LOGS=true
SENTRY_DSN=  # Add your Sentry DSN for error tracking
SENTRY_SAMPLE_RATE=1.0  # 0.0 to 1.0, percentage of errors to capture
SENTRY_TRACES_SAMPLE_RATE=0.1  # 0.0 to 1.0, percentage of transactions to trace
APP_VERSION=1.0.0
SERVER_NAME=expense-tracker

# Production Security Recommendations:
# 1. Generate a strong SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Set ENVIRONMENT=production
# 3. Set HTTPS_ONLY=true
# 4. Set SECURE_COOKIES=true  
# 5. Configure CORS_ORIGINS with your actual domain(s)
# 6. Use strong database credentials
# 7. Enable rate limiting with appropriate limits
# 8. Consider key rotation for JWT_KEY_ID and JWT_PREVIOUS_KEYS